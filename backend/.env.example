# Copy to backend/.env (never commit .env)
#
# Backend loads repo-root .env first, then merges backend/.env (override wins).
#
# Use BACKEND_PORT so root .env PORT=3000 (Next.js) never binds Express on the same port.
# Hosting platforms that only set PORT still work via resolveListenPort() in production.

BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sollend

SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=

# Optional: unix seconds pool “launch” for APY estimation (GET /loan/pool/stats)
# POOL_LAUNCH_TS=

# CORS and scoring RPC use SOLANA_RPC_URL in code paths
