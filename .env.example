# Copy to .env.local for local Next.js (never commit .env.local)
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
#
# Put Next.js-only vars (e.g. PORT=3001) in .env.local — not in repo-root .env — so the
# backend loader does not pick up PORT. Backend copies backend/.env.example → backend/.env.

NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_API_URL=http://localhost:4000

# After deploy: your Anchor program id (base58)
# NEXT_PUBLIC_PROGRAM_ID=

# Optional: comma-separated base58 pubkeys that may use /admin in the UI
# NEXT_PUBLIC_ADMIN_WALLETS=
